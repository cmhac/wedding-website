# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used in magic-link redirects and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values come from `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only)
RESEND_API_KEY=
# Verified sending address, e.g. "Chris & Hannah <hello@example.com>"
EMAIL_FROM=

# Supabase Send Email hook signature secret (server-only)
SEND_EMAIL_HOOK_SECRET=
# Resend webhook signing secret (server-only)
RESEND_WEBHOOK_SECRET=
# Bearer token for the scheduled-send endpoint (server-only)
CRON_SECRET=
# Path where the guest frontend serves the RSVP (used to build links in emails)
GUEST_RSVP_PATH=/rsvp

# Time zone every admin date and time is shown and entered in
NEXT_PUBLIC_ADMIN_TIME_ZONE=America/Los_Angeles
