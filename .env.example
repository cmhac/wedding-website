# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used in magic-link redirects and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values come from `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only)
RESEND_API_KEY=
# Verified sending address, e.g. "Chris & Hannah <hello@example.com>"
EMAIL_FROM=

# Twilio text messages (all server-only). Texting stays OFF and hidden, and the
# admin console shows a warning banner, until these are set. Never prefix with
# NEXT_PUBLIC_. Setup steps: docs/manual-setup.md, "Twilio text messages".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred: the messaging service the approved campaign is attached to.
TWILIO_MESSAGING_SERVICE_SID=
# Or, instead of a messaging service, the sending number in E.164 (+1...).
# TWILIO_FROM_NUMBER=

# Supabase Send Email hook signature secret (server-only)
SEND_EMAIL_HOOK_SECRET=
# Resend webhook signing secret (server-only)
RESEND_WEBHOOK_SECRET=
# Bearer token for the scheduled-send endpoint (server-only)
CRON_SECRET=
# Long random string that keys personal invite links and sign-in hashes (server-only).
# Changing it invalidates every invite link already sent.
INVITE_LINK_SECRET=
# Domain for each household's synthetic Auth address; mail to it never routes
HOUSEHOLD_ACCOUNT_EMAIL_DOMAIN=households.invalid
# Optional. Where signed-in guests land. Unset, they land on the placeholder
# homepage at "/"; set it to the RSVP path once the designer's RSVP page exists.
# (The RSVP link inside emails uses /rsvp until this is set.)
# GUEST_RSVP_PATH=/rsvp

# Time zone every admin date and time is shown and entered in
NEXT_PUBLIC_ADMIN_TIME_ZONE=America/Los_Angeles
